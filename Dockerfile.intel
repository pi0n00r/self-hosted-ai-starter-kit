FROM ubuntu:24.04

# 1) Configure Intel's oneAPI repository for the CPU-side runtime libraries.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg \
 && curl -fsSL \
      https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
      -o /tmp/intel-oneapi.asc \
 && gpg --dearmor -o /usr/share/keyrings/oneapi-archive-keyring.gpg \
      /tmp/intel-oneapi.asc \
 && rm /tmp/intel-oneapi.asc \
 && echo "deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main" \
    > /etc/apt/sources.list.d/oneAPI.list

# 2) Add pinned Intel GPU runtime .debs before any other GPU packages.
#    Versions are pinned and held to prevent apt upgrades from pulling in
#    incompatible IGC or Level Zero releases that break SYCL device enumeration.
COPY intel-igc-core-2_2.14.1+19448_amd64.deb \
     intel-igc-opencl-2_2.14.1+19448_amd64.deb \
     libze-intel-gpu1_25.27.34303.5-0_amd64.deb /tmp/
COPY intel-gpu-packages.sha256 /tmp/intel-gpu-packages.sha256

RUN cd /tmp \
 && sha256sum -c intel-gpu-packages.sha256 \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      intel-oneapi-mkl \
      intel-oneapi-tbb \
      intel-oneapi-openmp \
      intel-oneapi-dnnl \
      /tmp/intel-igc-core-2_2.14.1+19448_amd64.deb \
      /tmp/intel-igc-opencl-2_2.14.1+19448_amd64.deb \
      /tmp/libze-intel-gpu1_25.27.34303.5-0_amd64.deb \
 && apt-mark hold intel-igc-core-2 intel-igc-opencl-2 libze-intel-gpu1 \
 # Remove VAAPI/media drivers that conflict with headless SYCL inference.
 # These cause silent CPU fallback if present — do not re-add.
 && apt-get purge -y --auto-remove \
      i965-va-driver va-driver-all mesa-va-drivers \
      intel-media-va-driver-non-free libmfx1 libmfxgen1 libvpl2 \
      mesa-utils libegl1-mesa libgl1-mesa-dri vainfo \
      intel-oneapi-runtime-compilers intel-oneapi-runtime-dpcpp \
 && rm -rf /var/lib/apt/lists/* /tmp/*.deb /tmp/intel-gpu-packages.sha256
 
# 3) Headless EGL + Level Zero environment defaults.
#    LIBVA_DRIVER_NAME is intentionally omitted — the iHD VA-API stack
#    is purged above and setting it would be a dangling reference.
ENV EGL_PLATFORM=surfaceless \
    OLLAMA_INTEL_GPU=true \
    ONEAPI_DEVICE_SELECTOR=level_zero:0
 
# 4) Source oneAPI environment at container startup via entrypoint.
#    /etc/profile.d/ is only sourced by interactive login shells and
#    is NOT executed by Docker CMD — use an entrypoint wrapper instead.
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
 
# 5) Install IPEX-LLM Portable Ollama Build
ENV OLLAMA_DIR=/usr/local/lib/ollama \
    OLLAMA_BIN=/usr/local/bin/ollama
 
RUN curl -L -o /tmp/ollama.tgz https://github.com/ipex-llm/ipex-llm/releases/download/v2.2.0/ollama-ipex-llm-2.2.0-ubuntu.tgz \
 && mkdir -p ${OLLAMA_DIR} \
 && tar zxvf /tmp/ollama.tgz -C ${OLLAMA_DIR} \
 && ln -sf ${OLLAMA_DIR}/ollama ${OLLAMA_BIN} \
 && rm /tmp/ollama.tgz
 
# 6) Verify sycl-ls is available from the IPEX-LLM tarball extraction.
#    If sycl-ls is not on PATH after extraction, the HEALTHCHECK will
#    silently fail at runtime — surface the error at build time instead.
RUN which sycl-ls || (echo "❌ sycl-ls not found on PATH after IPEX-LLM extraction" && exit 1)
 
# 7) Sanity-check: fail the build if blocklisted VAAPI drivers are present.
RUN if dpkg -l 2>/dev/null | grep -E "i965-va-driver|va-driver-all|mesa-va-drivers"; then \
      echo "❌ Blocklisted VAAPI drivers found — build aborted" && exit 1; \
    else \
      echo "✅ No banned VAAPI drivers detected"; \
    fi
 
EXPOSE 11434
 
# 8) Healthcheck uses sycl-ls to verify iGPU device enumeration is live.
HEALTHCHECK --interval=30s --timeout=10s \
  CMD sycl-ls || exit 1
 
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["ollama", "serve"]

# Copy this file to .env and replace all placeholder values before use.
# The .env file is gitignored and must never be committed to the repository.

POSTGRES_USER=CHANGEME_postgres_user
POSTGRES_PASSWORD=CHANGEME_strong_password
POSTGRES_DB=n8n

# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGEME_generate_with_openssl_rand_hex_32

# Generate with: openssl rand -hex 32
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGEME_generate_with_openssl_rand_hex_32

N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true

# Uncomment and set for Mac users running Ollama locally outside Docker.
# See README for Mac / Apple Silicon setup instructions.
# OLLAMA_HOST=host.docker.internal:11434

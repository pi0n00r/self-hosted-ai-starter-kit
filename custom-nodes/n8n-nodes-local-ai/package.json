{
	"name": "n8n-nodes-local-ai",
	"version": "0.1.1",
	"description": "An internal n8n chat-model node for OpenAI-compatible local inference endpoints",
	"license": "MIT",
	"private": true,
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"local-ai",
		"openai-compatible"
	],
	"author": {
		"name": "Gary Bajaj",
		"email": "gary@bajaj.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"nodes": [
			"dist/nodes/LocalAi/LmChatLocalAi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/ai-node-sdk": "0.19.8",
		"@n8n/node-cli": "0.40.3",
		"n8n-workflow": "2.29.3",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"peerDependencies": {
		"@n8n/ai-node-sdk": "0.19.8",
		"n8n-workflow": "*"
	}
}
